# ============================================================
# ClientOS — environment template
# Copy to backend/.env and fill in real values. NEVER commit .env
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- PostgreSQL (application metadata only, NOT memory) ---
DATABASE_URL=postgresql://clientos:clientos@localhost:5432/clientos

# --- Hindsight (the memory layer) ---
# Get a key from Hindsight Cloud -> Organization -> API Keys (starts with hsk_)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Optional; defaults to "default"
HINDSIGHT_TENANT_ID=default

# --- Groq (reasoning) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Demo controls ---
# Shared token required by the destructive demo reset endpoint
DEMO_RESET_TOKEN=change-me-local-dev-only

# ============================================================
# Frontend (frontend/.env) — the ONLY frontend variable.
# No secret is ever exposed to the browser.
# ============================================================
# VITE_API_BASE_URL=http://localhost:5000
